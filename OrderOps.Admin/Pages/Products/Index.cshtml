@page
@model OrderOps.Admin.Pages.Products.IndexModel

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<p>
    <a asp-page="Create" class="btn btn-primary">Create Product</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th class="text-end">Price</th>
            <th class="text-end">Stock</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.Name</td>
                <td class="text-end">@product.Price.ToString("C")</td>
                <td class="text-end">@product.Stock</td>
                <td class="text-end">
                    <a asp-page="Details" asp-route-id="@product.Id">Details</a> |
                    <a asp-page="Edit" asp-route-id="@product.Id">Edit</a> |
                    <a asp-page="Delete" asp-route-id="@product.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>