@page "{id:int}"
@model OrderOps.Admin.Pages.Orders.CancelModel

@{
    ViewData["Title"] = "Cancel Order";
}

<h1>Cancel Order</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="alert alert-warning">
    Are you sure you want to cancel this order? Stock will be restored.
</div>

<dl class="row">
    <dt class="col-sm-2">Order Id</dt>
    <dd class="col-sm-10">@Model.Order!.Id</dd>

    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-10">@Model.Order.CustomerName</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Order.Status</dd>

    <dt class="col-sm-2">Total</dt>
    <dd class="col-sm-10">@Model.Order.Total.ToString("C")</dd>
</dl>

<form method="post">
    <input type="hidden" name="id" value="@Model.Order.Id" />

    <button type="submit" class="btn btn-danger">Cancel Order</button>
    <a asp-page="Details" asp-route-id="@Model.Order.Id" class="btn btn-secondary">Back</a>
</form>